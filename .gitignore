# The uv workspace shares one virtual environment, at the repository root.
.venv
dist
__pycache__
.mypy_cache
.pytest_cache
.ruff_cache

# OS
.DS_Store
Thumbs.db
.vscode

# ignore database files generated by tests
*.db
*.db.wal

# Ignore .env in lightly_studio.
lightly_studio/.env

# Ignore studio example datasets.
dataset_examples_studio

.claude/settings.local.json

# Top-level tmp dir.
/tmp/

# Coverage artifacts, written into whichever workspace member the suite ran in.
.coverage
coverage.json

.local.gitignore

# Media uploaded through the GUI (LIGHTLY_STUDIO_UPLOAD_DIR), wherever the server was started.
lightly_studio_uploads/
projects/uploads/

# COCO datasets prepared from the GUI (LIGHTLY_STUDIO_DATASETS_DIR).
lightly_studio_datasets/
projects/datasets/

# Crash logs of the frontend client generator.
lightly_studio_view/openapi-ts-error-*.log
